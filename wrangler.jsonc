// Cloudflare Worker: the app's files, the API, the live connection and the cron (ADR-006).
// Secrets are not here: set GOOGLE_CLIENT_SECRET, BOOTSTRAP_ADMIN_EMAILS and TMDB_API_KEY with
// `npx wrangler secret put <NAME>`, and locally in .dev.vars (see .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pede-pra-pacoca",
  "main": "server/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GROUP", "class_name": "Group" }]
  },
  // Never edit a shipped migration; add the next tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Group"] }],
  // One cron for every time-based job; the rules decide what is due in America/Sao_Paulo.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "GOOGLE_CLIENT_ID": ""
  },
  "observability": { "enabled": true },
  // No Wrangler usage telemetry from builds or CI (docs/SEGURANCA.md).
  "send_metrics": false
}
