# The Pede's address, without a trailing slash.
PEDE_URL=https://
# The same value set in the Worker with `npx wrangler secret put PACOCAST_TOKEN`.
PACOCAST_TOKEN=
# The Jellyseerr as seen from the Paçocast's container.
JELLYSEERR_URL=http://jellyseerr:5055
# Jellyseerr > Settings > General > API Key.
JELLYSEERR_API_KEY=
# Seconds between rounds; at least 30.
PACOCAST_INTERVAL_SECONDS=45
